#!/bin/bash

### Called after installation: select the binary matching the NAS architecture.

APP_DIR="${TRIM_APPDEST:-/var/apps/papersplit/target}"
BIN_DIR="${APP_DIR}/bin"
ARCH="$(uname -m)"

case "${ARCH}" in
    x86_64|amd64)
        CPU="x86_64"
        ;;
    aarch64|arm64)
        CPU="aarch64"
        ;;
    armv7l|armv7)
        CPU="armv7"
        ;;
    *)
        echo "Unsupported architecture: ${ARCH}" >&2
        exit 1
        ;;
esac

SRC="${BIN_DIR}/papersplit-server_${CPU}"
if [ ! -f "${SRC}" ]; then
    echo "Missing binary for ${CPU}" >&2
    exit 1
fi

mv -f "${SRC}" "${BIN_DIR}/papersplit-server"
chmod 755 "${BIN_DIR}/papersplit-server"
rm -f "${BIN_DIR}"/papersplit-server_*

# Fail fast if the binary cannot run on this CPU.
if ! "${BIN_DIR}/papersplit-server" --version >/dev/null 2>&1; then
    echo "Bundled binary does not match this architecture (${ARCH})" >&2
    exit 1
fi

exit 0
